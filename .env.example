# Copiez ce fichier vers .env et renseignez votre clé côté serveur uniquement.
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici
ANTHROPIC_MODEL=claude-3-5-haiku-latest
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
# Indiquez le nombre d'intermédiaires fiables uniquement derrière un proxy maîtrisé.
TRUST_PROXY=

# Notifications push : générez votre propre paire avec `npx web-push generate-vapid-keys`.
# Sans ces deux clés, la section "Notifications du patrimoine" reste visible
# mais indique poliment que le service n'est pas encore configuré.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:contact@teranga-patrimoine.sn

# Base de données PostgreSQL : persiste les abonnements aux notifications
# push et le classement des quiz (sans elle, tout reste en mémoire et se
# perd au redémarrage). Fonctionne avec n'importe quel Postgres hébergé
# (Render, Railway, Neon, Supabase...) ou local.
DATABASE_URL=
# Facultatif : activez-le seulement si votre fournisseur local n'utilise pas SSL.
DATABASE_SSL=false

# Comptes admin/client (requiert DATABASE_URL).
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
